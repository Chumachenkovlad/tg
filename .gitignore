node_modules/
.DS_Store
*.log

# Local secrets — never commit
.env
.env.local

# Telegram MTProto session (auth key) — sensitive credential.
# The default location is ~/.tg-8042/, outside the repository; this covers a
# TELEGRAM_SESSION_PATH pointed inside it.
.telegram/

# NOTE: telegram/managed-state.json is deliberately NOT ignored. It is
# non-secret deployment identity metadata (logical key -> Telegram id) and is
# committed, so a fresh checkout knows which chats are already ours.

# The apply lock is transient machine state. It normally lives next to the
# session, outside the repository; this covers a custom session path pointed
# inside it.
apply.lock
