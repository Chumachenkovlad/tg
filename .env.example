# Telegram MTProto API credentials.
# Get them at https://my.telegram.org -> API development tools.
# Copy this file to .env and fill in your own values. Never commit .env.

TELEGRAM_API_ID=000000
TELEGRAM_API_HASH=your_api_hash_here

# Optional: custom session file location.
# Default: ~/.tg-8042/session — a directory this app creates and keeps at 0700.
# When you set a custom path, the app writes the session file (0600) but leaves
# the permissions of the surrounding directory untouched.
# TELEGRAM_SESSION_PATH=/absolute/or/relative/path/to/session
