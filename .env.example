# Telegram MTProto API credentials.
# Get them at https://my.telegram.org -> API development tools.
# Copy this file to .env and fill in your own values. Never commit .env.

TELEGRAM_API_ID=000000
TELEGRAM_API_HASH=your_api_hash_here

# Optional: where the local session is stored (default: .telegram/session)
# TELEGRAM_SESSION_PATH=.telegram/session
